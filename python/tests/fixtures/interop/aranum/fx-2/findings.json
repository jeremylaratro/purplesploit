    "classes": {
      "kerberoastable-hash-es-captured-aada6591": {
        "category": "ad",
        "title": "Kerberoastable service account(s)",
        "why": "Any domain user can request a Kerberos service ticket (TGS) for an account with an SPN; the ticket is encrypted with the account's NTLM hash and can be cracked offline. Weak service-account passwords yield domain credentials.",
        "test": [
          {
            "label": "Enumerate SPN accounts (read-only)",
            "cmd": "nxc ldap <host> -u <user> -p <pass> --kerberoasting kerb.txt"
          },
          {
            "label": "Impacket, list only",
            "cmd": "GetUserSPNs.py <domain>/<user>:<pass> -dc-ip <host>"
          }
        ],
        "fix": [
          {
            "label": "Use Group Managed Service Accounts (gMSA)",
            "text": "Replace SPN-bearing user accounts with gMSAs so Windows manages a 120-char random password that rotates automatically."
          },
          {
            "label": "Enforce strong passwords where gMSA is impossible",
            "text": "Set service-account passwords to >=25 random characters and audit SPN accounts with `Get-ADUser -Filter {ServicePrincipalName -like '*'}`."
          }
        ],
        "refs": [
          "https://attack.mitre.org/techniques/T1558/003/",
          "https://learn.microsoft.com/windows-server/security/group-managed-service-accounts/group-managed-service-accounts-overview"
        ],
        "attack_ids": [
          "T1558.003"
        ]
      },
      "bsigning-disabled-b-bsigning-enabled-but-not-required-b-65edaf46": {
        "category": "ad",
        "title": "SMB signing not required (NTLM relay)",
        "why": "SMB signing is disabled or not enforced, so captured/coerced NTLM authentication can be relayed to this host for code execution or privilege escalation.",
        "test": [
          {
            "label": "Confirm signing state (read-only)",
            "cmd": "nxc smb <host> --gen-relay-list relay.txt"
          }
        ],
        "fix": [
          {
            "label": "Require SMB signing (GPO)",
            "text": "Set 'Microsoft network server: Digitally sign communications (always)' = Enabled on servers and clients."
          },
          {
            "label": "PowerShell",
            "cmd": "Set-SmbServerConfiguration -RequireSecuritySignature $true -Force"
          }
        ],
        "refs": [
          "https://learn.microsoft.com/windows-server/storage/file-server/smb-signing"
        ],
        "attack_ids": []
      }
    },
    "checks": {
      "LIN-ACCT-NOPASSWD": {
        "os": "linux",
        "scope": "host",
        "group": "accounts",
        "category": "linlocal",
        "title": "sudo NOPASSWD rules",
        "sev_fail": "",
        "sev_warn": "medium",
        "semantics": "WARN: >=1 NOPASSWD rule in sudoers/sudoers.d; PASS: none; ERR: sudoers unreadable (needs root); NA: sudo absent.",
        "why": "A sudo NOPASSWD rule allows the authorized command to run without a fresh authentication check. Malware or an attacker controlling that account can immediately exercise the delegated privilege, and broad command rules may lead directly to root access.",
        "test": [
          {
            "label": "Find active NOPASSWD directives",
            "cmd": "sudo grep -RHE '^[[:space:]]*[^#].*NOPASSWD[[:space:]]*:' /etc/sudoers /etc/sudoers.d 2>/dev/null"
          }
        ],
        "fix": [
          {
            "label": "Remove or narrowly scope passwordless sudo",
            "text": "Use visudo to remove unnecessary NOPASSWD tags or restrict them to exact non-shell commands with fixed arguments; avoid ALL, interpreters, editors, and commands that can execute arbitrary code."
          }
        ],
        "refs": [
          "https://www.sudo.ws/docs/man/sudoers.man/"
        ],
        "attack_ids": []
      },
      "WIN-UAC-LATFP": {
        "os": "windows",
        "scope": "host",
        "group": "access-control",
        "category": "winlocal",
        "title": "LocalAccountTokenFilterPolicy",
        "sev_fail": "",
        "sev_warn": "medium",
        "semantics": "WARN: LocalAccountTokenFilterPolicy=1 (full admin token for remote local-account logons; pass-the-hash); PASS: 0/absent.",
        "why": "LocalAccountTokenFilterPolicy=1 grants a full administrator token to remote network logons using local accounts. An attacker who obtains a local administrator hash can use pass-the-hash for unrestricted remote administration and lateral movement.",
        "test": [
          {
            "label": "Read the remote local-account token policy",
            "cmd": "reg query \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\" /v LocalAccountTokenFilterPolicy"
          }
        ],
        "fix": [
          {
            "label": "Restore remote UAC token filtering",
            "cmd": "reg add \"HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\" /v LocalAccountTokenFilterPolicy /t REG_DWORD /d 0 /f"
          }
        ],
        "refs": [
          "https://learn.microsoft.com/en-us/troubleshoot/windows-server/windows-security/user-account-control-and-remote-restriction",
          "https://attack.mitre.org/techniques/T1550/002/"
        ],
        "attack_ids": [
          "T1550.002"
        ]
      },
      "AD-MAQ": {
        "os": "windows",
        "scope": "domain",
        "group": "domain-policy",
        "category": "ad",
        "title": "Machine account quota",
        "sev_fail": "",
        "sev_warn": "medium",
        "semantics": "WARN: ms-DS-MachineAccountQuota>0 (any user can join computers; RBCD/Certifried aid); PASS: 0.",
        "why": "A positive machine-account quota lets ordinary authenticated users create computer accounts in the domain. Attackers can abuse those accounts in resource-based constrained delegation, certificate-service attack chains, or other identity-manipulation techniques.",
        "test": [
          {
            "label": "Read the domain machine-account quota",
            "cmd": "$d=Get-ADDomain; Get-ADObject -Identity $d.DistinguishedName -Properties 'ms-DS-MachineAccountQuota' | Select-Object Name,'ms-DS-MachineAccountQuota'"
          }
        ],
        "fix": [
          {
            "label": "Set the machine-account quota to zero",
            "cmd": "Set-ADDomain -Identity (Get-ADDomain).DistinguishedName -Replace @{'ms-DS-MachineAccountQuota'=0}"
          },
          {
            "label": "Delegate joins explicitly",
            "text": "Grant computer-creation or domain-join rights only to a controlled provisioning identity or approved administrators in the required organizational units."
          }
        ],
        "refs": [
          "https://learn.microsoft.com/en-us/windows/win32/adschema/a-ms-ds-machineaccountquota",
          "https://attack.mitre.org/techniques/T1136/002/"
        ],
        "attack_ids": [
          "T1136.002"
        ]
      }
    }
