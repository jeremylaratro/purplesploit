{
  "openapi": "3.1.0",
  "info": {"title": "Fixture API", "version": "1"},
  "servers": [{"url": "https://{region}.example.test/api", "variables": {"region": {"default": "fixture"}}}],
  "security": [{"oauth": ["read"], "key": []}, {"key": []}],
  "components": {
    "securitySchemes": {"oauth": {"type": "oauth2", "flows": {"clientCredentials": {"tokenUrl": "/token", "scopes": {"read": "Read"}}}}, "key": {"type": "apiKey", "in": "header", "name": "X-Key"}},
    "requestBodies": {"Pet": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Pet"}}}}},
    "schemas": {"Pet": {"type": "object", "properties": {"parent": {"$ref": "#/components/schemas/Pet"}}}}
  },
  "paths": {"/pets": {"post": {"operationId": "createPet", "requestBody": {"$ref": "#/components/requestBodies/Pet"}, "responses": {"201": {"description": "Created"}}}}}
}
