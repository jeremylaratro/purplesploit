{
  "swagger": "2.0",
  "info": {"title": "Fixture API", "version": "1"},
  "host": "api.example.test:8443",
  "basePath": "/v1",
  "schemes": ["https", "https"],
  "consumes": ["application/json"],
  "securityDefinitions": {"key": {"type": "apiKey", "in": "header", "name": "X-Fixture-Key"}},
  "security": [{"key": []}],
  "parameters": {"id": {"name": "id", "in": "path", "required": true, "type": "string"}},
  "paths": {
    "/pets/{id}": {
      "parameters": [{"$ref": "#/parameters/id"}, {"name": "verbose", "in": "query", "type": "boolean"}],
      "get": {"operationId": "getPet", "security": [], "parameters": [{"name": "verbose", "in": "query", "type": "integer"}], "responses": {"200": {"description": "pet"}}},
      "put": {"operationId": "updatePet", "parameters": [{"name": "pet", "in": "body", "schema": {"$ref": "#/definitions/Pet"}}], "responses": {"204": {"description": "updated"}}}
    }
  },
  "definitions": {"Pet": {"type": "object", "properties": {"name": {"type": "string"}}}}
}
