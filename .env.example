# Generate a random value; never commit the real token.
PURPLESPLOIT_API_TOKEN=replace-with-at-least-16-random-characters
PURPLESPLOIT_DATA_DIR=/secure/path/purplesploit
PURPLESPLOIT_HOST=127.0.0.1
PURPLESPLOIT_PORT=5000
PURPLESPLOIT_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
